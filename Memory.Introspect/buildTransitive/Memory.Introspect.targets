<Project>
  <!--
    Shipped inside the Memory.Introspect NuGet package and auto-imported by referencing
    projects. On build it looks for a `.claude` folder at or above the consuming
    project and, when found, extracts the package's `skills/` payload into
    `.claude/skills/memory-introspect/` (re-copying only when the package version changes).
    Does nothing when there is no `.claude` folder.

    The target, the inline task and every property are prefixed so this file can be
    imported alongside another package that ships the same mechanism (Tesserae does):
    MSBuild resolves a duplicate target name or a duplicate top-level property by
    last-import-wins, silently, so unprefixed names would mean only one of the two
    packages ever installs its skill.
  -->
  <PropertyGroup>
    <!-- Install folder name = the skill's name (kebab-case). Intentionally lowercase
         'memory-introspect' (the `name:` in skills/SKILL.md), not the PackageId
         'Memory.Introspect'. The targets *filename* must still equal the PackageId so
         NuGet auto-imports it; the target name is what a SessionStart hook invokes with
         `-t:_InstallMemoryIntrospectClaudeSkills`. -->
    <_MISkillsPackageId>memory-introspect</_MISkillsPackageId>
    <!-- Targets sits in buildTransitive/; the skills/ payload is one level up in the restored package -->
    <_MISkillsSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'skills'))</_MISkillsSourceDir>
  </PropertyGroup>

  <!-- Walk up the tree to find the nearest ancestor containing a .claude folder.
       Done in code rather than via $(SolutionDir), which is only defined when
       building through a .sln and breaks under `dotnet build SomeProject.csproj`. -->
  <UsingTask TaskName="FindClaudeDirForMemoryIntrospect"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <StartDirectory ParameterType="System.String" Required="true" />
      <ClaudeDirectory ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var dir = new System.IO.DirectoryInfo(StartDirectory);
        while (dir != null) {
            var candidate = System.IO.Path.Combine(dir.FullName, ".claude");
            if (System.IO.Directory.Exists(candidate)) { ClaudeDirectory = candidate; break; }
            dir = dir.Parent;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_InstallMemoryIntrospectClaudeSkills"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">

    <FindClaudeDirForMemoryIntrospect StartDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ClaudeDirectory" PropertyName="_MIClaudeDir" />
    </FindClaudeDirForMemoryIntrospect>

    <PropertyGroup Condition="'$(_MIClaudeDir)' != ''">
      <_MISkillsTargetDir>$([MSBuild]::NormalizeDirectory('$(_MIClaudeDir)', 'skills', '$(_MISkillsPackageId)'))</_MISkillsTargetDir>
      <_MIShippedVersionFile>$(_MISkillsSourceDir).skills-version</_MIShippedVersionFile>
      <_MIInstalledVersionFile>$(_MISkillsTargetDir).skills-version</_MIInstalledVersionFile>
    </PropertyGroup>

    <!-- Read shipped version (always present in the package) -->
    <ReadLinesFromFile File="$(_MIShippedVersionFile)"
                       Condition="'$(_MIClaudeDir)' != '' and Exists('$(_MIShippedVersionFile)')">
      <Output TaskParameter="Lines" PropertyName="_MIShippedVersion" />
    </ReadLinesFromFile>

    <!-- Read installed version (absent on first install) -->
    <ReadLinesFromFile File="$(_MIInstalledVersionFile)"
                       Condition="'$(_MIClaudeDir)' != '' and Exists('$(_MIInstalledVersionFile)')">
      <Output TaskParameter="Lines" PropertyName="_MIInstalledVersion" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_MINeedsInstall Condition="'$(_MIClaudeDir)' != '' and '$(_MIShippedVersion)' != '$(_MIInstalledVersion)'">true</_MINeedsInstall>
    </PropertyGroup>

    <!-- Version differs (or first install): wipe the folder and recopy everything -->
    <RemoveDir Condition="'$(_MINeedsInstall)' == 'true'"
               Directories="$(_MISkillsTargetDir)" />

    <ItemGroup Condition="'$(_MINeedsInstall)' == 'true'">
      <_MISkillFiles Include="$(_MISkillsSourceDir)**\*" />
    </ItemGroup>

    <Copy Condition="'$(_MINeedsInstall)' == 'true' and '@(_MISkillFiles)' != ''"
          SourceFiles="@(_MISkillFiles)"
          DestinationFiles="@(_MISkillFiles->'$(_MISkillsTargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
          OverwriteReadOnlyFiles="true" />

    <Message Condition="'$(_MINeedsInstall)' == 'true'" Importance="high"
             Text="Skills $(_MISkillsPackageId) updated $(_MIInstalledVersion) → $(_MIShippedVersion) in $(_MISkillsTargetDir)" />
  </Target>
</Project>
